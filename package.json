{
  "name": "helipopper-playground",
  "version": "0.0.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "build": "ng build @ngneat/helipopper --configuration production",
    "publish": "npm publish --access=public dist/ngneat/helipopper/"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-browser-dynamic": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@ngneat/overview": "^8.1.0",
    "rxjs": "~7.8.0",
    "tippy.js": "6.3.7",
    "tslib": "2.3.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "@cypress/webpack-preprocessor": "5.15.5",
    "@ngneat/spectator": "^7.1.0",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "24.5.2",
    "all-contributors-cli": "^6.8.1",
    "angular-cli-ghpages": "^0.6.2",
    "chalk": "^5.6.2",
    "cross-env": "^5.2.0",
    "cypress": "15.13.1",
    "git-cz": "^3.2.1",
    "husky": "^3.0.1",
    "istanbul-lib-instrument": "^6.0.3",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "lint-staged": "^9.2.0",
    "ng-packagr": "^22.0.1",
    "prettier": "3.6.2",
    "serve": "14.2.6",
    "standard-version": "^8.0.2",
    "start-server-and-test": "^1.12.2",
    "ts-node": "~8.3.0",
    "typescript": "~6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,json,css,scss,ts,html,component.html}": [
      "prettier --write",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -e $GIT_PARAMS",
      "pre-commit": "pnpm hooks:pre-commit && pnpm exec lint-staged"
    }
  }
}
